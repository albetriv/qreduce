# .clineignore for Python / Poetry projects
# Purpose: reduce Cline context noise while keeping source, tests, docs, and config accessible.
# Reference: https://docs.cline.bot/customization/clineignore

# --- Python caches and bytecode ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.virtualenv/
.python-version

# --- Packaging and build outputs ---
build/
dist/
.eggs/
*.egg-info/
*.egg
pip-wheel-metadata/
*.whl
site/

# --- Test, coverage, lint, type-check caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache/

# --- Jupyter / notebook generated state ---
.ipynb_checkpoints/

# --- IDE and editor noise ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Keep workspace Cline configuration and rules visible
!.cline/
!.cline/skills/
!.cline/skills/**
!.clinerules/
!.clinerules/**

# --- Cline temporary working files ---
.cline-tmp/

# --- Logs and runtime artifacts ---
*.log
logs/
*.pid
*.pid.lock

# --- Environment and secrets ---
.env
.env.*
*.pem
*.key
*.crt
*.p12
*.pfx
*.secret
secrets/

# Keep the project CA certificate visible because MCP servers use it for NODE_EXTRA_CA_CERTS
!src/ext/cato-ca.pem

# --- Databases and local state ---
*.sqlite
*.sqlite3
*.db
*.duckdb
*.db-journal

# --- Large data and binary artifacts ---
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.pickle
*.joblib
*.onnx
*.pt
*.pth
*.bin
*.dat
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# --- Media and generated reports ---
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.webp
*.ico
*.pdf
*.mp4
*.mov
*.avi
*.mp3
*.wav

# --- Node artifacts if auxiliary tooling is added ---
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# --- Keep important project files accessible ---
!README.md
!specifications.md
!pyproject.toml
!poetry.lock
!src/
!src/**
!tests/
!tests/**
