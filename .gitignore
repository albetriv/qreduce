# Runtime and temporary files produced by Cline.
.cline/
.cline-tmp/

# Python bytecode, tools, virtual environments, and build artifacts.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
.ipynb_checkpoints/
dist/
build/
*.egg-info/

# Repository experiment artifacts are reproducible outputs, not source files.
# Track only the placeholder so the output root exists in fresh clones.
outputs/*
!outputs/.gitkeep

# Log files generated by the logging system.
logs/

# User-acquired OR-Library files remain external; do not delete local copies.
/data/benchmarks/or_library/capacitated_facility_location/*.txt

# Node.js (for UIX tests)
node_modules/
package-lock.json